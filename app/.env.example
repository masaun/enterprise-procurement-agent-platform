# ─────────────────────────────────────────────────────────────────────────
# Enterprise Procurement Agent — Management Platform — environment variables
# Copy to .env.local and fill in what you have. Every value below has a
# safe fallback for local dev (see app/README.md for the full table).
#
# This app is the platform, not the actor — it no longer holds KeeperHub
# credentials or a treasury signing key. Those now live on the external
# agent's own machine (see ../agent-skills/README.md's PROCURE_* variables).
# ─────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────
APP_PUBLIC_ORIGIN=http://localhost:3000

# ── Lucid Agents SDK: @lucid-agents/payments (SIWX) ────────────────────
SIWX_PUBLIC_ORIGIN=http://localhost:3000
PAYMENTS_RECEIVABLE_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENTS_NETWORK=eip155:84532
PAYMENTS_FACILITATOR_URL=

# ── Lucid Agents SDK: @lucid-agents/identity (ERC-8004) ─────────────────
# Also used for the live inbound gate in lib/identity/gate.ts and the
# on-chain reads/writes in lib/chain/registry.ts (Base Sepolia by default).
AGENT_DOMAIN=
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
IDENTITY_AGENT_ID=
REGISTER_IDENTITY=false
IDENTITY_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=

# Signs the ERC-8004 mint for the dashboard's "Authorize Agent (by
# Registering in the ERC-8004)" panel — register() mints the identity to
# whichever wallet signs, so this key no longer has to be the agent's own
# (e.g. agent-demo/.env's PROCURE_PRIVATE_KEY) — it just needs Base Sepolia
# testnet ETH for gas. Named for what it is: the enterprise admin's own
# signer, not any particular agent's — never a ProcurementRegistry key
# (that allowlist has no platform key at all; see below).
# Used only as a fallback: if the admin clicks "Connect Wallet" in the
# dashboard, their own browser wallet signs and pays gas instead (and the
# panel's "Agent Wallet Address" field transfers the minted identity to
# whichever agent wallet the admin names, either way).
ENTERPRISE_ADMIN_PRIVATE_KEY=
# Client-side mirrors of CHAIN_ID/IDENTITY_REGISTRY_ADDRESS above, used only
# by the "Connect Wallet" registration path (lib/identity/registerBrowser.ts)
# to target a non-default deployment — Next.js inlines NEXT_PUBLIC_-prefixed
# vars into the browser bundle, so never put a secret in one.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=

# Backs the dashboard's "Faucet" panel — mints Aave's Base Sepolia test USDC
# to any address via Aave's own permissionless Faucet contract, signed by
# ENTERPRISE_ADMIN_PRIVATE_KEY above (or, if a wallet is connected in the
# browser, by that wallet instead — see lib/chain/faucetBrowser.ts). Defaults
# below are Aave's real Base Sepolia deployment (see
# agent-demo/README.md's token table); only override if that changes.
FAUCET_CONTRACT_ADDRESS=0xD9145b5F45Ad4519c7ACcD6E0A4A82e83bB8A6Dc
FAUCET_USDC_ADDRESS=0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f
# Client-side mirrors of the two above, for the connected-wallet mint path
# (Next.js only inlines NEXT_PUBLIC_-prefixed vars into the browser bundle).
NEXT_PUBLIC_FAUCET_CONTRACT_ADDRESS=0xD9145b5F45Ad4519c7ACcD6E0A4A82e83bB8A6Dc
NEXT_PUBLIC_FAUCET_USDC_ADDRESS=0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f

# ── MCP (./app/api/agent/mcp) ────────────────────────────────────────────
AGENT_MCP_API_KEY=

# ── On-chain procurement history (./contracts, Base Sepolia) ────────────
# No PROCUREMENT_REGISTRY_ADDRESS / CONTRACT_OWNER_PRIVATE_KEY here on
# purpose — a ProcurementRegistry's Ownable owner is always the wallet that
# created it via ProcurementRegistryFactory below, so there's no platform
# key that could administer its authorizedAgents allowlist. The dashboard
# tracks which registry is "active" (for history reads and the inbound
# agent report gate) in server memory, kept in sync with whichever registry
# the connected wallet creates/selects — see lib/chain/activeRegistryStore.ts.

# Backs the dashboard's "New ProcurementRegistry contract creation" panel —
# lets a connected wallet deploy its own ProcurementRegistry via
# ProcurementRegistryFactory.createNewProcurementRegistry()
# (contracts/src/ProcurementRegistryFactory.sol), becoming that registry's
# owner on-chain. Always signed by the connected wallet, never a platform
# key — see lib/chain/factoryBrowser.ts.
NEXT_PUBLIC_PROCUREMENT_REGISTRY_FACTORY_ADDRESS="0x37B32265AdD721156dA8F6192a619FBCaD4522e3"

# ── Procurement policy defaults (seeded, editable in the dashboard UI) ──
POLICY_MAX_USD_PER_TASK=2
POLICY_MIN_APY_BPS=100
POLICY_ALLOWED_ASSETS=USDC
# compound-v3 and morpho are excluded: their gateway contract addresses in
# lib/lucid/mock-providers.ts are illustrative/fake (no real Base Sepolia
# deployment), so a run that selects either always fails at the KeeperHub
# ABI-fetch step. aave-v3 is the only gateway with a real, verified
# contract on Base Sepolia — see agent-demo/README.md's policy section.
POLICY_ALLOWED_PROTOCOLS=aave-v3
