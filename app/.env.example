# ─────────────────────────────────────────────────────────────────────────
# Enterprise Procurement Agent — environment variables
# Copy to .env.local and fill in what you have. Every value below has a
# safe DEMO_MODE fallback (see app/README.md for the full table + behavior).
# ─────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────
APP_PUBLIC_ORIGIN=http://localhost:3000
DEMO_MODE=true

# ── Lucid Agents SDK: @lucid-agents/payments (SIWX) ────────────────────
SIWX_PUBLIC_ORIGIN=http://localhost:3000
PAYMENTS_RECEIVABLE_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENTS_NETWORK=eip155:84532
PAYMENTS_FACILITATOR_URL=

# ── Lucid Agents SDK: @lucid-agents/identity (ERC-8004) ─────────────────
AGENT_DOMAIN=
RPC_URL=
CHAIN_ID=84532
IDENTITY_AGENT_ID=
REGISTER_IDENTITY=false

# ── Lucid Agents SDK: @lucid-agents/wallet (agent's own signing wallet) ─
DEVELOPER_WALLET_PRIVATE_KEY=
AGENT_WALLET_PRIVATE_KEY=

# ── MCP (./app/api/agent/mcp) ────────────────────────────────────────────
AGENT_MCP_API_KEY=

# ── KeeperHub (@keeperhub/sdk) ──────────────────────────────────────────
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_EXECUTION_MODE=direct

# ── Procurement policy defaults (seeded, editable in the UI) ───────────
POLICY_MAX_USD_PER_TASK=1000000
POLICY_MIN_APY_BPS=400
POLICY_ALLOWED_ASSETS=USDC
POLICY_ALLOWED_PROTOCOLS=aave-v3,compound-v3,morpho
