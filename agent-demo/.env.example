# --- LLM (OpenRouter — https://openrouter.ai/docs/quickstart) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as HTTP-Referer / X-Title so this app shows up correctly in OpenRouter's dashboard/rankings.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=agent-demo

# --- Persona: which real external agent this demo run is standing in for ---
# One of: hermes | openclaw | generic
AGENT_DEMO_PERSONA=generic
AGENT_DEMO_NAME=Demo External Agent
AGENT_DEMO_MAX_TOOL_ITERATIONS=12

# --- Paths (defaults resolve relative to this package; override only if you moved things) ---
# AGENT_SKILLS_DIR=../agent-skills
# PROCURE_CLI_BIN=../agent-skills/scripts/cli/bin/procure.ts

# --- Passed straight through to the shelled-out `procure` CLI process (see agent-skills/README.md) ---
PROCURE_BASE_URL=http://localhost:3000
PROCURE_PRIVATE_KEY=
PROCURE_MCP_API_KEY=
PROCURE_KEEPERHUB_API_KEY=
PROCURE_KEEPERHUB_BASE_URL=
PROCURE_KEEPERHUB_EXECUTION_MODE=direct
PROCURE_REGISTRY_ADDRESS=
PROCURE_RPC_URL=

# --- Only used by `agent-demo webhook --secret ...` to simulate a signed dispatch from ./app ---
DEMO_WEBHOOK_SECRET=demo-secret
